# GEO Suite -- environment template (single source; never a per-service copy).
# Every variable the backend reads (backend/app/config.py) appears here
# exactly once. Real values are supplied via the environment or a local
# .env before deploy; the defaults in config.py let the app import for tests.

APP_ENV=local
FRONTEND_ORIGIN=http://localhost:3000
LOG_LEVEL=INFO

# Supabase project URL (project e7e387ee-65f4-4b5a-9b14-c8e665f79d29).
SUPABASE_URL=

# Client-scoped key, safe for reads under RLS. From Supabase dashboard:
# Project Settings -> API -> Project API keys -> anon / public.
SUPABASE_ANON_KEY=

# Server-side only. Bypasses RLS -- never expose to the frontend. From
# Supabase dashboard: Project Settings -> API -> Project API keys -> service_role.
SUPABASE_SERVICE_ROLE_KEY=

# Direct Postgres connection string, used by the health check. From Supabase
# dashboard: Project Settings -> Database -> Connection string (URI). Use the
# Session pooler (IPv4) string, not the direct host -- Railway (and most
# hosts) can't reach db.<ref>.supabase.co directly.
SUPABASE_DB_URL=

# Supabase project's JWT secret. From Supabase dashboard: Project Settings ->
# API -> JWT Settings -> JWT Secret.
SUPABASE_JWT_SECRET=
