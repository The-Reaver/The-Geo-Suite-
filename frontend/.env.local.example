# frontend/.env.local.example
# Copy this file to frontend/.env.local and paste your real values.
# The frontend runs on these placeholder values, so you can build before
# you have live keys. Every key here is safe for the browser. Keep every
# secret key in the backend .env file, never in this one.

# Supabase (project lhzxmvjwqllmnqecfxpm)
# Project URL from your Supabase dashboard under Settings, then API.
NEXT_PUBLIC_SUPABASE_URL=https://placeholder-project.supabase.co
# The anon public key from the same page. Row-level security protects
# your data, so this key is safe to expose to the browser.
NEXT_PUBLIC_SUPABASE_ANON_KEY=placeholder-anon-key

# Backend API
# The base URL the frontend calls for the FastAPI backend.
# Local development points at the backend dev server.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# App identity
NEXT_PUBLIC_APP_NAME=GEO Suite
